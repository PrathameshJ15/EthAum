# EthAum Frontend Environment Variables
# API Backend Base URL
VITE_API_URL=http://localhost:8000

# Supabase Public Configuration (Safe for client-side use)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Payment Gateway Public Keys (Public client keys ONLY - NEVER add secrets here!)
VITE_PAYMENT_PROVIDER=mock
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key_id
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
